{
  "name": "voidbloom",
  "productName": "VOIDBLOOM",
  "version": "2.0.1",
  "description": "A neon survivors-like: solo or co-op, 5 ships, 3 arenas, 11 evolving weapons.",
  "main": "electron/main.js",
  "author": "Richard Gils",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "npx --yes serve web -l 8080",
    "desktop": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.voidbloom.game",
    "productName": "VOIDBLOOM",
    "files": [
      "electron/**",
      "web/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "VOIDBLOOM-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "VOIDBLOOM-Portable-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ryangils",
        "repo": "voidbloom",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
